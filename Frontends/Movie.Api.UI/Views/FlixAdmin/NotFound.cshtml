@{ Layout = "_FlixAuthLayout"; }

	<!-- page 404 -->
	<div class="page-404 section--bg" >
		<div class="container">
			<div class="row">
				<div class="col-12">
					<div class="page-404__wrap">
						<div class="page-404__content">
                            <h1 class="page-404__title">@Context.Response.StatusCode</h1>
                            <p class="page-404__text">@(Context.Response.StatusCode == 404 ? "The page you are looking for is not available!" : "This request could not be completed.")</p>
							<a href="/" class="page-404__btn">go back</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- end page 404 -->

	
