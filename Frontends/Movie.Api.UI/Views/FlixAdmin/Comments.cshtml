@model FlixAdminViewModel
@{ Layout = "_FlixAdminLayout"; }
<main class="main">
		<div class="container-fluid"><p class="flix-message">Comments display the text of existing movie reviews. A separate comment system is not configured.</p>
			<div class="row">
				<!-- main title -->
				<div class="col-12">
					<div class="main__title">
						<h2>Comments</h2>

						<span class="main__title-stat">@Model.Total total</span>

						<div class="main__title-wrap">
							

							<!-- search -->
							<form method="get" class="main__title-form">
								<input type="search" name="query" value="@Model.Query" placeholder="Key word..">
								<button type="submit" aria-label="Search">
									<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8.25998" cy="8.25995" r="7.48191" stroke="#2F80ED" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></circle><path d="M13.4637 13.8523L16.3971 16.778" stroke="#2F80ED" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
								</button>
							</form>
							<!-- end search -->
						</div>
					</div>
				</div>
				<!-- end main title -->

				<!-- comments -->
				<div class="col-12">
					<div class="main__table-wrap">
						<table class="main__table">
							<thead><tr><th>ID</th><th>MOVIE</th><th>AUTHOR ID</th><th>COMMENT</th><th>LIKES</th><th>DATE</th><th>ACTIONS</th></tr></thead>

							<tbody>@if (Model.Total == 0 && Model.Error == null) { <tr><td colspan="7"><div class="main__table-text">No matching records.</div></td></tr> }@foreach (var item in Model.Reviews) { <tr><td><div class="main__table-text">@item.ReviewID</div></td><td><div class="main__table-text"><a href="@(item.SeriesID.HasValue ? "/series/" + item.SeriesID : "/details/" + item.MovieID)">@(item.SeriesID.HasValue ? "Series " + item.SeriesID : "Movie " + item.MovieID)</a></div></td><td><div class="main__table-text">@item.UserID</div></td><td><div class="main__table-text">@item.ReviewComment</div></td><td><div class="main__table-text">@item.LikeCount</div></td><td><div class="main__table-text">@item.ReviewDate?.ToString("yyyy-MM-dd")</div></td><td><div class="main__table-btns"><a href="#review-@item.ReviewID" class="main__table-btn main__table-btn--view open-modal" aria-label="Read review"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.92,11.6C19.9,6.91,16.1,4,12,4S4.1,6.91,2.08,11.6a1,1,0,0,0,0,.8C4.1,17.09,7.9,20,12,20s7.9-2.91,9.92-7.6A1,1,0,0,0,21.92,11.6ZM12,18c-3.17,0-6.17-2.29-7.9-6C5.83,8.29,8.83,6,12,6s6.17,2.29,7.9,6C18.17,15.71,15.17,18,12,18ZM12,8a4,4,0,1,0,4,4A4,4,0,0,0,12,8Zm0,6a2,2,0,1,1,2-2A2,2,0,0,1,12,14Z"></path></svg></a></div></td></tr> }</tbody>
						</table>
					</div>
				</div>
				<!-- end comments -->

				<partial name="_FlixAdminPagination" model="Model" />
			</div>
		</div>
	</main>@foreach (var item in Model.Reviews) { <div id="review-@item.ReviewID" class="zoom-anim-dialog mfp-hide modal"><h4 class="modal__title">Review @item.ReviewID</h4><p class="modal__text">@item.ReviewComment</p><p class="modal__text">Rating: @item.UserRating · @item.ReviewDate?.ToString("yyyy-MM-dd")</p><div class="modal__btns"><button class="modal__btn modal__btn--dismiss" type="button">Close</button></div></div> }