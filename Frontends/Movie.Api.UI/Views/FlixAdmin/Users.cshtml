@model FlixAdminViewModel
@{ Layout = "_FlixAdminLayout"; }
<main class="main">
		<div class="container-fluid">
			<div class="row">
				<!-- main title -->
				<div class="col-12">
					<div class="main__title">
						<h2>Users</h2>

						<span class="main__title-stat">@Model.Total total</span>

						<div class="main__title-wrap">
							

							<!-- search -->
							<form method="get" class="main__title-form">
								<input type="search" name="query" value="@Model.Query" placeholder="Find user..">
								<button type="submit" aria-label="Search">
									<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8.25998" cy="8.25995" r="7.48191" stroke="#2F80ED" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></circle><path d="M13.4637 13.8523L16.3971 16.778" stroke="#2F80ED" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
								</button>
							</form>
							<!-- end search -->
						</div>
					</div>
				</div>
				<!-- end main title -->

				@if (Model.Error != null) { <div class="col-12"><p class="flix-message" role="alert">@Model.Error</p></div> }
<!-- users -->
				<div class="col-12">
					<div class="main__table-wrap">
						<table class="main__table">
							<thead><tr><th>ID</th><th>USERNAME</th><th>EMAIL</th><th>NAME</th><th>STATUS</th><th>EMAIL STATUS</th><th>ACTIONS</th></tr></thead>

							<tbody>@if (Model.Total == 0 && Model.Error == null) { <tr><td colspan="7"><div class="main__table-text">No matching records.</div></td></tr> }@foreach (var item in Model.Users) { <tr><td><div class="main__table-text" title="@item.Id">@(item.Id.Length > 8 ? item.Id[..8] : item.Id)</div></td><td><div class="main__user"><div class="main__avatar"><img src="/FlixTheme/admin/images/user.svg" alt=""></div><div class="main__meta"><h3><a href="/admin/flix/edit-user/@item.Id">@item.UserName</a></h3><span>@item.Email</span></div></div></td><td><div class="main__table-text">@item.Email</div></td><td><div class="main__table-text">@item.FullName</div></td><td><div class="main__table-text @(item.IsLockedOut ? "main__table-text--red" : "main__table-text--green")">@(item.IsLockedOut ? "Locked" : "Active")</div></td><td><div class="main__table-text">@(item.EmailConfirmed ? "Verified" : "Unverified")</div></td><td><div class="main__table-btns"><a href="/admin/flix/edit-user/@item.Id" class="main__table-btn main__table-btn--edit" aria-label="Edit user"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22,7.24a1,1,0,0,0-.29-.71L17.47,2.29A1,1,0,0,0,16.76,2a1,1,0,0,0-.71.29L13.22,5.12h0L2.29,16.05a1,1,0,0,0-.29.71V21a1,1,0,0,0,1,1H7.24A1,1,0,0,0,8,21.71L18.87,10.78h0L21.71,8a1.19,1.19,0,0,0,.22-.33,1,1,0,0,0,0-.24.7.7,0,0,0,0-.14ZM6.83,20H4V17.17l9.93-9.93,2.83,2.83ZM18.17,8.66,15.34,5.83l1.42-1.41,2.82,2.82Z"></path></svg></a></div></td></tr> }</tbody>
						</table>
					</div>
				</div>
				<!-- end users -->

				<partial name="_FlixAdminPagination" model="Model" />
			</div>
		</div>
	</main>