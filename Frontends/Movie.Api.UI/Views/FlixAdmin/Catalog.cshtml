@model FlixAdminViewModel
@{ Layout = "_FlixAdminLayout"; }
<main class="main">
		<div class="container-fluid">
			<div class="row">
				<!-- main title -->
				<div class="col-12">
					<div class="main__title">
						<h2>Catalog</h2>

						<span class="main__title-stat">@Model.Total total</span>

						<div class="main__title-wrap">
							<div class="filter" id="filter__sort">
                                <span class="filter__item-label">Sort by:</span>
                                <div class="filter__item-btn dropdown-toggle" id="filter-sort" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <input type="button" value="@(Model.Sort == "rating" ? "Rating" : Model.Sort == "title" ? "Title" : "Newest year")" aria-label="Sort catalog"><span></span>
                                </div>
                                <ul class="filter__item-menu dropdown-menu scrollbar-dropdown" aria-labelledby="filter-sort">
                                    <li role="button" tabindex="0" data-sort="newest">Newest year</li>
                                    <li role="button" tabindex="0" data-sort="rating">Rating</li>
                                    <li role="button" tabindex="0" data-sort="title">Title</li>
                                </ul>
                            </div>

							<!-- search -->
							<form method="get" class="main__title-form">
                                <input type="hidden" name="sort" value="@Model.Sort">
								<input type="search" name="query" value="@Model.Query" placeholder="Find movie / tv series..">
								<button type="submit" aria-label="Search">
									<svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8.25998" cy="8.25995" r="7.48191" stroke="#2F80ED" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></circle><path d="M13.4637 13.8523L16.3971 16.778" stroke="#2F80ED" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
								</button>
							</form>
							<!-- end search -->
						</div>
					</div>
				</div>
				<!-- end main title -->

				@if (Model.Error != null) { <div class="col-12"><p class="flix-message" role="alert">@Model.Error</p></div> }
<!-- users -->
				<div class="col-12">
					<div class="main__table-wrap">
						<table class="main__table">
							<thead><tr><th>ID</th><th>TITLE</th><th>RATING</th><th>TYPE</th><th>GENRE</th><th>STATUS</th><th>YEAR</th><th>ACTIONS</th></tr></thead>

							<tbody>@if (Model.Total == 0 && Model.Error == null) { <tr><td colspan="8"><div class="main__table-text">No matching records.</div></td></tr> }@foreach (var item in Model.Items) { <tr><td><div class="main__table-text">@item.Id</div></td><td><div class="main__table-text"><a href="@item.Url">@item.Title</a></div></td><td><div class="main__table-text main__table-text--rate"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22,9.67A1,1,0,0,0,21.14,9l-5.69-.83L12.9,3a1,1,0,0,0-1.8,0L8.55,8.16,2.86,9a1,1,0,0,0-.81.68,1,1,0,0,0,.25,1l4.13,4-1,5.68A1,1,0,0,0,6.9,21.44L12,18.77l5.1,2.67a.93.93,0,0,0,.46.12,1,1,0,0,0,.59-.19,1,1,0,0,0,.4-1l-1-5.68,4.13-4A1,1,0,0,0,22,9.67Zm-6.15,4a1,1,0,0,0-.29.88l.72,4.2-3.76-2a1.06,1.06,0,0,0-.94,0l-3.76,2,.72-4.2a1,1,0,0,0-.29-.88l-3-3,4.21-.61a1,1,0,0,0,.76-.55L12,5.7l1.88,3.82a1,1,0,0,0,.76.55l4.21.61Z"></path></svg>@item.RatingText</div></td><td><div class="main__table-text">@item.Kind</div></td><td><div class="main__table-text">@item.Category</div></td><td><div class="main__table-text @(item.Published ? "main__table-text--green" : "main__table-text--red")">@(item.Published ? "Visible" : "Hidden")</div></td><td><div class="main__table-text">@item.Year</div></td><td><div class="main__table-btns"><a href="@item.Url" class="main__table-btn main__table-btn--view" aria-label="View title"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.92,11.6C19.9,6.91,16.1,4,12,4S4.1,6.91,2.08,11.6a1,1,0,0,0,0,.8C4.1,17.09,7.9,20,12,20s7.9-2.91,9.92-7.6A1,1,0,0,0,21.92,11.6ZM12,18c-3.17,0-6.17-2.29-7.9-6C5.83,8.29,8.83,6,12,6s6.17,2.29,7.9,6C18.17,15.71,15.17,18,12,18ZM12,8a4,4,0,1,0,4,4A4,4,0,0,0,12,8Zm0,6a2,2,0,1,1,2-2A2,2,0,0,1,12,14Z"></path></svg></a><a href="@(item.Kind == "movie" ? "/Admin/AdminMovie/UpdateMovie/" + item.Id : "/Admin/AdminSeries/UpdateSeries/" + item.Id)" class="main__table-btn main__table-btn--edit" aria-label="Edit title"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22,7.24a1,1,0,0,0-.29-.71L17.47,2.29A1,1,0,0,0,16.76,2a1,1,0,0,0-.71.29L13.22,5.12h0L2.29,16.05a1,1,0,0,0-.29.71V21a1,1,0,0,0,1,1H7.24A1,1,0,0,0,8,21.71L18.87,10.78h0L21.71,8a1.19,1.19,0,0,0,.22-.33,1,1,0,0,0,0-.24.7.7,0,0,0,0-.14ZM6.83,20H4V17.17l9.93-9.93,2.83,2.83ZM18.17,8.66,15.34,5.83l1.42-1.41,2.82,2.82Z"></path></svg></a></div></td></tr> }</tbody>
						</table>
					</div>
				</div>
				<!-- end users -->

				<partial name="_FlixAdminPagination" model="Model" />
			</div>
		</div>
	</main>
