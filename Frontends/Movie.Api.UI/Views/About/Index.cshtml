@{
    ViewData["Title"] = "Hakkımızda";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<!-- head -->
<section class="section section--head section--head-fixed">
	<div class="container">
		<div class="row">
			<div class="col-12 col-xl-6">
				<h1 class="section__title section__title--head">FlixTV – Sinema &amp; Dizi Platformu</h1>
			</div>

			<div class="col-12 col-xl-6">
				<ul class="breadcrumb">
					<li class="breadcrumb__item"><a href="/">Ana Sayfa</a></li>
					<li class="breadcrumb__item breadcrumb__item--active">Hakkımızda</li>
				</ul>
			</div>
		</div>
	</div>
</section>
<!-- end head -->

<!-- about -->
<section class="section section--pb0">
	<div class="container">
		<div class="row">
			<!-- section text -->
			<div class="col-12">
				<p class="section__text section__text--small">
					<b>FlixTV Movie API</b>, modern sinema ve dizi severlere en güncel içerikleri, detaylı film detaylarını, oyuncu kadrolarını ve kullanıcı değerlendirmelerini sunmak amacıyla tasarlanmış yüksek performanslı bir Web API platformudur. 
				</p>
				<p class="section__text section__text--small">
					Onion Architecture ve Clean Architecture prensipleriyle inşa edilen platformumuz, kesintisiz veri akışı, gelişmiş arama ve kişiselleştirilmiş favori listesi yönetimi sunar. Sinema dünyasının en popüler yapımlarını keşfetmek, detaylı analizler yapmak ve favori listenizi oluşturmak artık çok kolay.
				</p>
			</div>
			<!-- end section text -->
		</div>

		<!-- steps -->
		<div class="row row--grid" style="margin-top: 30px;">
			<div class="col-12 col-lg-4">
				<div class="step">
					<span class="step__number">01</span>
					<h3 class="step__title">Hesabınızı Oluşturun</h3>
					<p class="step__text">Ücretsiz bir şekilde kayıt olarak kişisel film ve dizi koleksiyonunuzu oluşturmaya başlayın.</p>
				</div>
			</div>
			
			<div class="col-12 col-lg-4">
				<div class="step">
					<span class="step__number">02</span>
					<h3 class="step__title">İçerikleri Keşfedin</h3>
					<p class="step__text">Kategoriler, oyuncular ve popülerlik sıralamalarına göre yüzlerce film ve TV dizisini filtreleyin.</p>
				</div>
			</div>

			<div class="col-12 col-lg-4">
				<div class="step">
					<span class="step__number">03</span>
					<h3 class="step__title">Favorilerinize Ekleyin</h3>
					<p class="step__text">Beğendiğiniz yapımları favori listenize ekleyin ve kaldığınız yerden keyifle takip edin.</p>
				</div>
			</div>
		</div>
		<!-- end steps -->
	</div>
</section>

<!-- stats -->
<section class="section section--pb0">
	<div class="container">
		<div class="row row--grid">
			<div class="col-12 col-sm-6 col-lg-3">
				<div style="background: #282830; border-radius: 8px; padding: 25px; text-align: center;">
					<h2 style="color: #ff55a5; font-size: 36px; margin: 0;">5,000+</h2>
					<p style="color: #b9b9c0; margin-top: 5px;">Kayıtlı Film &amp; Dizi</p>
				</div>
			</div>

			<div class="col-12 col-sm-6 col-lg-3">
				<div style="background: #282830; border-radius: 8px; padding: 25px; text-align: center;">
					<h2 style="color: #ff55a5; font-size: 36px; margin: 0;">1,200+</h2>
					<p style="color: #b9b9c0; margin-top: 5px;">Oyuncu &amp; Yönetmen</p>
				</div>
			</div>

			<div class="col-12 col-sm-6 col-lg-3">
				<div style="background: #282830; border-radius: 8px; padding: 25px; text-align: center;">
					<h2 style="color: #ff55a5; font-size: 36px; margin: 0;">99.9%</h2>
					<p style="color: #b9b9c0; margin-top: 5px;">Kesintisiz API Erişimi</p>
				</div>
			</div>

			<div class="col-12 col-sm-6 col-lg-3">
				<div style="background: #282830; border-radius: 8px; padding: 25px; text-align: center;">
					<h2 style="color: #ff55a5; font-size: 36px; margin: 0;">24/7</h2>
					<p style="color: #b9b9c0; margin-top: 5px;">Kullanıcı Desteği</p>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- end stats -->
