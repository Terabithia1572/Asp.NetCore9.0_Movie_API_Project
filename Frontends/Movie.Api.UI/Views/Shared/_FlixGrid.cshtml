@model FlixCatalogViewModel
<div class="row row--grid">
@if (Model.Error != null) { <div class="col-12"><p class="section__text" role="alert">@Model.Error</p></div> }
else if (Model.Items.Count == 0) { <div class="col-12"><p class="section__text">No titles match these filters. <a href="/category">Clear filters</a></p></div> }
@foreach (var item in Model.Items) { <div class="col-6 col-sm-4 col-lg-3 col-xl-2"><partial name="_FlixCard" model="item" /></div> }
</div>