@model FlixAdminViewModel
@if (Model.Pages > 1) { <div class="col-12"><div class="paginator"><span class="paginator__pages">@Model.Total total</span><ul class="paginator__paginator">
@if (Model.Page > 1) { <li><a href="?page=@(Model.Page - 1)&amp;query=@Uri.EscapeDataString(Model.Query ?? "")&amp;sort=@Uri.EscapeDataString(Model.Sort)" aria-label="Previous page"><svg width="14" height="11" viewBox="0 0 14 11" fill="none"><path d="M0.75 5.36475L13.1992 5.36475" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M5.771 10.1271L0.749878 5.36496L5.771 0.602051" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li> }
@for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.Pages, Model.Page + 2); p++) { <li class="@(p == Model.Page ? "active" : "")"><a href="?page=@p&amp;query=@Uri.EscapeDataString(Model.Query ?? "")&amp;sort=@Uri.EscapeDataString(Model.Sort)" aria-current="@(p == Model.Page ? "page" : null)">@p</a></li> }
@if (Model.Page < Model.Pages) { <li><a href="?page=@(Model.Page + 1)&amp;query=@Uri.EscapeDataString(Model.Query ?? "")&amp;sort=@Uri.EscapeDataString(Model.Sort)" aria-label="Next page"><svg width="14" height="11" viewBox="0 0 14 11" fill="none"><path d="M13.1992 5.3645L0.75 5.3645" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path><path d="M8.17822 0.602051L13.1993 5.36417L8.17822 10.1271" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></li> }
</ul></div></div> }
