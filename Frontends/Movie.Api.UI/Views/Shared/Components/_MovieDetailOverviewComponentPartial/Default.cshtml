@model Movie.Api.UI.Models.MovieDetailOverviewViewModel

<div id="overview" class="tab active">
	<div class="row">
		<div class="col-md-8 col-sm-12 col-xs-12">
			<p>@(Model?.Movie?.MovieDescription ?? "Bu film için açıklama bulunmamaktadır.")</p>

			<div class="title-hd-sm">
				<h4>Oyuncular (@(Model?.Casts?.Count ?? 0))</h4>
			</div>
			<!-- movie cast -->
			<div class="mvcast-item">
				@if (Model?.Casts != null && Model.Casts.Any())
				{
					foreach (var cast in Model.Casts)
					{
						<div class="cast-it">
							<div class="cast-left">
								<img src="@(string.IsNullOrEmpty(cast.CastImageURL) ? "/MovieTheme/images/uploads/cast1.jpg" : cast.CastImageURL)" alt="@cast.CastFullName" style="width: 45px; height: 45px; object-fit: cover; border-radius: 50%;">
								<a href="#" style="margin-left: 10px; font-weight: 600;">@cast.CastFullName</a>
							</div>
							<p style="color: #abb7c4;">@(string.IsNullOrEmpty(cast.CastTitle) ? cast.CastFullName : cast.CastTitle)</p>
						</div>
					}
				}
				else
				{
					<p style="color: #abb7c4; padding: 10px 0; font-style: italic;">Henüz oyuncu kadrosu eklenmemiştir.</p>
				}
			</div>

			<div class="title-hd-sm">
				<h4>Kullanıcı yorumları</h4>
				<a href="#reviews" class="time">Yorumlar Sekmesi <i class="ion-ios-arrow-right"></i></a>
			</div>
			<div class="mv-user-review-item">
				<h3>Film Hakkında Değerlendirme</h3>
				<div class="no-star">
					<i class="ion-android-star" style="color: #f5b50a;"></i>
					<span style="color: #fff; font-weight: bold; margin-left: 5px;">@(Model?.Movie?.MovieRating ?? 0) / 10</span>
				</div>
				<p class="time">
					Yayın Yılı: @(Model?.Movie?.MovileCreatedYear ?? "-")
				</p>
				<p>Filme yapılan kullanıcı yorumları ve incelemeleri yukarıdaki Yorumlar sekmesinden takip edebilirsiniz.</p>
			</div>
		</div>

		<div class="col-md-4 col-xs-12 col-sm-12">
			@if (Model?.Casts != null && Model.Casts.Any())
			{
				<div class="sb-it">
					<h6>Öne Çıkan Oyuncular:</h6>
					<p>
						@string.Join(", ", Model.Casts.Take(4).Select(c => c.CastFullName))
					</p>
				</div>
			}
			<div class="sb-it">
				<h6>Çıkış Tarihi:</h6>
				<p>@(Model?.Movie?.MovieReleaseDate.ToString("dd MMMM yyyy") ?? "-")</p>
			</div>
			<div class="sb-it">
				<h6>Film Süresi:</h6>
				<p>@(Model?.Movie?.MovieDuration ?? 0) dakika</p>
			</div>
			<div class="sb-it">
				<h6>Reyting Puanı:</h6>
				<p>@(Model?.Movie?.MovieRating ?? 0) / 10</p>
			</div>
			<div class="sb-it">
				<h6>Etiketler / Anahtar Kelimeler:</h6>
				<p class="tags" style="margin-top: 5px;">
					@if (Model?.Tags != null && Model.Tags.Any())
					{
						foreach (var tag in Model.Tags)
						{
							<span class="time" style="margin-right: 5px; margin-bottom: 8px; display: inline-block;">
								<a href="#" style="background: #233a50; padding: 4px 12px; border-radius: 12px; color: #4280bf; font-size: 11px; text-decoration: none; display: inline-block;">#@tag.TagTitle</a>
							</span>
						}
					}
					else
					{
						<span style="color: #abb7c4; font-size: 12px; font-style: italic;">Etiket eklenmemiş</span>
					}
				</p>
			</div>
			<div class="ads">
				<img src="~/MovieTheme/images/uploads/ads1.png" alt="">
			</div>
		</div>
	</div>
</div>
