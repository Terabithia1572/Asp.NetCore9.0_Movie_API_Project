<!DOCTYPE html><html lang="en"><head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

	<!-- CSS -->
	<link rel="stylesheet" href="/FlixTheme/css/bootstrap-reboot.min.css">
	<link rel="stylesheet" href="/FlixTheme/css/bootstrap-grid.min.css">
	<link rel="stylesheet" href="/FlixTheme/css/magnific-popup.css">
	@if (ViewData["Carousel"] is true) { <link rel="stylesheet" href="/FlixTheme/css/owl.carousel.min.css"> }
@if (ViewData["Select"] is true) { <link rel="stylesheet" href="/FlixTheme/css/slider-radio.css"><link rel="stylesheet" href="/FlixTheme/css/select2.min.css"> }
@if (ViewData["Player"] is true) { <link rel="stylesheet" href="/FlixTheme/css/plyr.css"> }
<link rel="stylesheet" href="/FlixTheme/css/main.css">
<link rel="stylesheet" href="/css/flix-integration.css" asp-append-version="true">

	<!-- Favicons -->
	<link rel="icon" type="image/png" href="/FlixTheme/images/favicon-32x32.png" sizes="32x32">
	<link rel="apple-touch-icon" href="/FlixTheme/images/favicon-32x32.png">

	<meta name="description" content="">
	<meta name="keywords" content="">
	<meta name="author" content="Dmitry Volkov">
	<title>@(ViewData["Title"] ?? "FlixTV") – Movies &amp; TV Shows</title>


@await RenderSectionAsync("Styles", required: false)</head><body>
<partial name="_FlixHeader" />
@RenderBody()
<partial name="_FlixFooter" />
<partial name="_FlixUnavailableModal" />
<form id="flix-antiforgery" hidden>@Html.AntiForgeryToken()</form>
<p class="flix-notice" id="flix-feedback" role="status" hidden></p>
<script src="/FlixTheme/js/jquery-3.5.1.min.js"></script>
<script src="/FlixTheme/js/bootstrap.bundle.min.js"></script>
@if (ViewData["Carousel"] is true) { <script src="/FlixTheme/js/owl.carousel.min.js"></script> }
@if (ViewData["Select"] is true) { <script src="/FlixTheme/js/select2.min.js"></script><script src="/FlixTheme/js/slider-radio.js"></script> }
<script src="/FlixTheme/js/smooth-scrollbar.js"></script>
<script src="/FlixTheme/js/jquery.magnific-popup.min.js"></script>
@if (ViewData["Player"] is true) { <script src="/FlixTheme/js/plyr.min.js"></script> }
<script src="/js/flix-theme.js" asp-append-version="true"></script>
<script src="/js/flix-integration.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
