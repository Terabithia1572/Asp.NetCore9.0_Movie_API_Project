@model Movie.Api.UI.Models.PagedListViewModel<ResultMovieDTO>

@{
    ViewData["Title"] = "Tüm Filmler";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

@if (ViewBag.IsSearch != true)
{
<!-- home carousel -->
<section class="home">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 class="home__title"><b>YENİ & POPÜLER</b> FİLMLER</h1>
            </div>
            <div class="col-12">
                <div class="owl-carousel home__carousel">
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items.OrderByDescending(x => x.MovieRating).Take(6))
                        {
                            <div class="card card--big">
                                <div class="card__cover">
                                    <img src="@(string.IsNullOrEmpty(item.MovieCoverImageURL) ? "/FlixTheme/images/1.jpg" : item.MovieCoverImageURL)" 
                                         alt="@item.MovieTitle" 
                                         onerror="this.onerror=null;this.src='/FlixTheme/images/1.jpg';" />
                                    <a href="/Movie/MovieDetail/@item.MovieID" class="card__play">
                                        <i class="icon ion-ios-play"></i>
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18.54,9,8.88,3.46a3.42,3.42,0,0,0-5.13,3V17.58A3.42,3.42,0,0,0,7.17,21a3.43,3.43,0,0,0,1.71-.46L18.54,15a3.42,3.42,0,0,0,0-5.92Zm-1,4.19L7.88,18.81a1.44,1.44,0,0,1-1.42,0,1.42,1.42,0,0,1-.71-1.23V6.42a1.42,1.42,0,0,1,.71-1.23A1.51,1.51,0,0,1,7.17,5a1.54,1.54,0,0,1,.71.19l9.66,5.58a1.42,1.42,0,0,1,0,2.46Z"></path></svg>
                                    </a>
                                    <span class="card__rate"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22,9.67A1,1,0,0,0,21.14,9l-5.69-.83L12.9,3a1,1,0,0,0-1.8,0L8.55,8.16,2.86,9a1,1,0,0,0-.81.68,1,1,0,0,0,.25,1l4.13,4-1,5.68A1,1,0,0,0,6.9,21.44L12,18.77l5.1,2.67a.93.93,0,0,0,.46.12,1,1,0,0,0,.59-.19,1,1,0,0,0,.4-1l-1-5.68,4.13-4A1,1,0,0,0,22,9.67Zm-6.15,4a1,1,0,0,0-.29.88l.72,4.2-3.76-2a1.06,1.06,0,0,0-.94,0l-3.76,2,.72-4.2a1,1,0,0,0-.29-.88l-3-3,4.21-.61a1,1,0,0,0,.76-.55L12,5.7l1.88,3.82a1,1,0,0,0,.76.55l4.21.61Z"></path></svg> @(item.MovieRating?.ToString("0.0") ?? "N/A")</span>
                                </div>
                                <div class="card__content">
                                    <h3 class="card__title"><a href="/Movie/MovieDetail/@item.MovieID">@item.MovieTitle</a></h3>
                                    <span class="card__category">
                                        <a href="/Category/Index?id=@item.CategoryID">Film</a>
                                    </span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>
<!-- end home carousel -->
}
else
{
<!-- head -->
<section class="section section--head section--head-fixed">
	<div class="container">
		<div class="row">
			<div class="col-12 col-xl-6">
				<h1 class="section__title section__title--head">Arama Sonuçları: @ViewBag.Query</h1>
			</div>
			<div class="col-12 col-xl-6">
				<ul class="breadcrumb">
					<li class="breadcrumb__item"><a href="/">Ana Sayfa</a></li>
					<li class="breadcrumb__item breadcrumb__item--active">Arama</li>
				</ul>
			</div>
		</div>
	</div>
</section>
<!-- end head -->
}

<!-- catalog -->
<div class="catalog catalog--page">
	<div class="container">
		<!-- filter bar -->
		<div class="row">
			<div class="col-12">
				<div class="catalog__nav">
					<div class="catalog__select-wrap">
						<span class="catalog__select-title">Sırala:</span>
						<select class="catalog__select" name="sort">
							<option value="rating">Reytinge Göre</option>
							<option value="year">Çıkış Yılına Göre</option>
							<option value="name">İsme Göre</option>
						</select>
					</div>
					<span class="catalog__pages" style="display: block; color: #b9b9c0; font-size: 13px;">Toplam @Model.TotalCount Film (Sayfa @Model.CurrentPage / @Model.TotalPages)</span>
				</div>
			</div>
		</div>

		<!-- card grid -->
		<div class="row row--grid">
			@if (Model.Items != null && Model.Items.Any())
			{
				foreach (var item in Model.Items)
				{
					<div class="col-6 col-sm-4 col-md-3 col-xl-2">
						<div class="card">
							<a href="/Movie/MovieDetail/@item.MovieID" class="card__cover">
								<img src="@(string.IsNullOrEmpty(item.MovieCoverImageURL) ? "/FlixTheme/images/1.jpg" : item.MovieCoverImageURL)" 
									 alt="@item.MovieTitle" 
									 onerror="this.onerror=null;this.src='/FlixTheme/images/1.jpg';" />
								<span class="card__play">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18.54,9,5,1.15A2.51,2.51,0,0,0,1.15,3.37V18.63A2.51,2.51,0,0,0,5,20.85L18.54,13A2.51,2.51,0,0,0,18.54,9Z"></path></svg>
								</span>
								<span class="card__rate">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22,9.67A1,1,0,0,0,21.14,9l-5.69-.83L12.9,3a1,1,0,0,0-1.8,0L8.55,8.16,2.86,9a1,1,0,0,0-.55,1.7l4.11,4L5.45,20.4a1,1,0,0,0,1.45,1.05L12,18.68l5.1,2.77a1,1,0,0,0,1.45-1.05l-.97-5.7,4.11-4A1,1,0,0,0,22,9.67Z"></path></svg>
									@(item.MovieRating?.ToString("0.0") ?? "N/A")
								</span>
							</a>
							<div class="card__content">
								<h3 class="card__title" style="white-space: normal; line-height: 1.3;"><a href="/Movie/MovieDetail/@item.MovieID">@item.MovieTitle</a></h3>
								<span class="card__category" style="white-space: normal; line-height: 1.3; display: flex; flex-wrap: wrap; gap: 4px;">
									<a href="/Category/Index?id=@item.CategoryID">Film</a>
									<a href="/Movie/MovieDetail/@item.MovieID">@item.MovileCreatedYear</a>
								</span>
							</div>
						</div>
					</div>
				}
			}
			else
			{
				<div class="col-12" style="padding: 40px 0; text-align: center;">
					<h3 style="color: #fff;">Henüz yayınlanmış bir film bulunmamaktadır.</h3>
				</div>
			}

			@if (Model.TotalPages > 1)
			{
				<!-- paginator -->
				<div class="col-12">
					<ul class="paginator">
						@if (Model.HasPreviousPage)
						{
							<li class="paginator__item paginator__item--prev">
								<a href="?page=@(Model.CurrentPage - 1)">&laquo;</a>
							</li>
						}
						@for (int i = 1; i <= Model.TotalPages; i++)
						{
							<li class="paginator__item @(Model.CurrentPage == i ? "paginator__item--active" : "")">
								<a href="?page=@i">@i</a>
							</li>
						}
						@if (Model.HasNextPage)
						{
							<li class="paginator__item paginator__item--next">
								<a href="?page=@(Model.CurrentPage + 1)">&raquo;</a>
							</li>
						}
					</ul>
				</div>
				<!-- end paginator -->
			}
		</div>
	</div>
</div>
<!-- end catalog -->
