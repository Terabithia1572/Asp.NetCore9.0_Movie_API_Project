@model Movie.Api.UI.Models.MovieDetailOverviewViewModel

@{
    var movie = Model?.Movie ?? new MovieApi.DTOs.DTOs.MovieDTO.ResultMovieDTO();
    ViewData["Title"] = movie.MovieTitle ?? "Film Detayı";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<!-- details -->
<section class="section section--details section--bg" data-bg="@(string.IsNullOrEmpty(movie.MovieCoverImageURL) ? "/FlixTheme/images/bg.jpg" : movie.MovieCoverImageURL)">
	<div class="container">
		<div class="row">
			<!-- title -->
			<div class="col-12">
				<h1 class="section__title section__title--head">@movie.MovieTitle</h1>
			</div>
			<!-- end title -->

			<!-- content -->
			<div class="col-12 col-xl-6">
				<div class="card card--details">
					<div class="row">
						<!-- card cover -->
						<div class="col-12 col-sm-5 col-md-4 col-lg-3 col-xl-5">
							<div class="card__cover">
								<img src="@(string.IsNullOrEmpty(movie.MovieCoverImageURL) ? "/FlixTheme/images/1.jpg" : movie.MovieCoverImageURL)" 
									 alt="@movie.MovieTitle"
									 onerror="this.onerror=null;this.src='/FlixTheme/images/1.jpg';">
								<span class="card__rate">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22,9.67A1,1,0,0,0,21.14,9l-5.69-.83L12.9,3a1,1,0,0,0-1.8,0L8.55,8.16,2.86,9a1,1,0,0,0-.55,1.7l4.11,4L5.45,20.4a1,1,0,0,0,1.45,1.05L12,18.68l5.1,2.77a1,1,0,0,0,1.45-1.05l-.97-5.7,4.11-4A1,1,0,0,0,22,9.67Z"></path></svg>
									@movie.MovieRating
								</span>
							</div>
						</div>
						<!-- end card cover -->

						<!-- card content -->
						<div class="col-12 col-sm-7 col-md-8 col-lg-9 col-xl-7">
							<div class="card__content">
								<ul class="card__meta">
									<li><span>Kategori:</span> <a href="/Category/Index?id=@movie.CategoryID">Film</a></li>
									<li><span>Yayın Yılı:</span> @movie.MovileCreatedYear</li>
									<li><span>Süre:</span> @(movie.MovieDuration) dk</li>
									<li><span>Yayın Tarihi:</span> @movie.MovieReleaseDate.ToString("dd.MM.yyyy")</li>
									@if (Model?.Tags != null && Model.Tags.Any())
									{
										<li>
											<span>Etiketler:</span>
											@foreach (var tag in Model.Tags)
											{
												<span class="badge" style="background-color: #2b2b35; color: #ff55a5; padding: 4px 8px; margin-right: 4px; border-radius: 4px;">#@tag.TagTitle</span>
											}
										</li>
									}
								</ul>

								<div class="card__description">
									@movie.MovieDescription
								</div>

								<div style="margin-top: 20px;">
									@if (User.Identity != null && User.Identity.IsAuthenticated)
									{
										<button id="btnToggleFavMovie" class="sign__btn" style="width: auto; padding: 0 25px; display: inline-flex; align-items: center; gap: 8px; height: 42px; line-height: 42px;" onclick="toggleFavoriteMovie(@movie.MovieID)">
											<svg id="favHeartIconMovie" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
												<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.72-8.72 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
											</svg>
											<span id="favBtnTextMovie">Favorilerime Ekle</span>
										</button>
									}
									else
									{
										<a href="/Login/Index" class="sign__btn" style="width: auto; padding: 0 25px; display: inline-flex; align-items: center; height: 42px; line-height: 42px;">
											Favorilere Eklemek İçin Giriş Yapın
										</a>
									}
								</div>
							</div>
						</div>
						<!-- end card content -->
					</div>
				</div>
			</div>
			<!-- end content -->
		</div>
	</div>
</section>
<!-- end details -->

<!-- content cast -->
<section class="content">
	<div class="container">
		<div class="row">
			<div class="col-12">
				<h2 class="content__title" style="margin-bottom: 20px;">Oyuncu Kadrosu</h2>
				@if (Model?.Casts != null && Model.Casts.Any())
				{
					<div class="row row--grid">
						@foreach (var actor in Model.Casts)
						{
							<div class="col-6 col-sm-4 col-md-3 col-xl-2" style="margin-bottom: 15px;">
								<div style="background: #282830; border-radius: 6px; padding: 15px; text-align: center;">
									<img src="@(string.IsNullOrEmpty(actor.CastImageURL) ? "/FlixTheme/images/avatar.svg" : actor.CastImageURL)" 
										 alt="@actor.CastFullName" 
										 onerror="this.onerror=null;this.src='/FlixTheme/images/avatar.svg';"
										 style="width: 70px; height: 70px; border-radius: 50%; object-fit: cover; margin-bottom: 10px;">
									<h5 style="color: #fff; font-size: 14px; margin: 0;">@actor.CastFullName</h5>
								</div>
							</div>
						}
					</div>
				}
				else
				{
					<p style="color: #b9b9c0;">Bu film için oyuncu kadrosu henüz eklenmedi.</p>
				}
			</div>
		</div>
	</div>
</section>

@section Scripts {
	<script>
		function toggleFavoriteMovie(movieId) {
			$.ajax({
				url: '/Favorite/ToggleMovieFavorite',
				type: 'POST',
				data: { movieId: movieId },
				success: function (res) {
					if (res && res.success) {
						var isFav = res.isFavorited;
						if (isFav) {
							$('#favHeartIconMovie').attr('fill', '#ff55a5').attr('stroke', '#ff55a5');
							$('#favBtnTextMovie').text('Favorilerimden Çıkar');
						} else {
							$('#favHeartIconMovie').attr('fill', 'none').attr('stroke', '#fff');
							$('#favBtnTextMovie').text('Favorilerime Ekle');
						}
					} else if (res && res.message) {
						alert(res.message);
					}
				},
				error: function () {
					alert('Favori işlemi sırasında bir hata oluştu.');
				}
			});
		}
	</script>
}
