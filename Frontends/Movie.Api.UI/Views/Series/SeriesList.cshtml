@model Movie.Api.UI.Models.PagedListViewModel<MovieApi.DTOs.DTOs.AdminSeriesDTOs.AdminResultSeriesDTO>

@{
    ViewData["Title"] = "Tüm TV Dizileri";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<!-- head -->
<section class="section section--head section--head-fixed">
	<div class="container">
		<div class="row">
			<div class="col-12 col-xl-6">
				<h1 class="section__title section__title--head">TV Dizileri Katalogu</h1>
			</div>

			<div class="col-12 col-xl-6">
				<ul class="breadcrumb">
					<li class="breadcrumb__item"><a href="/">Ana Sayfa</a></li>
					<li class="breadcrumb__item breadcrumb__item--active">Diziler</li>
				</ul>
			</div>
		</div>
	</div>
</section>
<!-- end head -->

<!-- catalog -->
<div class="catalog catalog--page">
	<div class="container">
		<div class="row">
			<div class="col-12">
				<div class="catalog__nav">
					<div class="catalog__select-wrap">
						<span class="catalog__select-title">Sırala:</span>
						<select class="catalog__select" name="sort">
							<option value="rating">Reytinge Göre</option>
							<option value="year">Çıkış Yılına Göre</option>
							<option value="name">İsme Göre</option>
						</select>
					</div>
					<span class="catalog__pages" style="display: block; color: #b9b9c0; font-size: 13px;">Toplam @Model.TotalCount Dizi (Sayfa @Model.CurrentPage / @Model.TotalPages)</span>
				</div>
			</div>
		</div>

		<div class="row row--grid">
			@if (Model.Items != null && Model.Items.Any())
			{
				foreach (var item in Model.Items)
				{
					<div class="col-6 col-sm-4 col-md-3 col-xl-2">
						<div class="card">
							<a href="/Series/SeriesDetail/@item.SeriesID" class="card__cover">
								<img src="@(string.IsNullOrEmpty(item.SeriesCoverImageURL) ? "/FlixTheme/images/1.jpg" : item.SeriesCoverImageURL)" 
									 alt="@item.SeriesTitle" 
									 onerror="this.onerror=null;this.src='/FlixTheme/images/1.jpg';" />
								<span class="card__play">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18.54,9,5,1.15A2.51,2.51,0,0,0,1.15,3.37V18.63A2.51,2.51,0,0,0,5,20.85L18.54,13A2.51,2.51,0,0,0,18.54,9Z"></path></svg>
								</span>
								<span class="card__rate">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22,9.67A1,1,0,0,0,21.14,9l-5.69-.83L12.9,3a1,1,0,0,0-1.8,0L8.55,8.16,2.86,9a1,1,0,0,0-.55,1.7l4.11,4L5.45,20.4a1,1,0,0,0,1.45,1.05L12,18.68l5.1,2.77a1,1,0,0,0,1.45-1.05l-.97-5.7,4.11-4A1,1,0,0,0,22,9.67Z"></path></svg>
									@(item.SeriesRating?.ToString("0.0") ?? "N/A")
								</span>
							</a>
							<div class="card__content">
								<h3 class="card__title"><a href="/Series/SeriesDetail/@item.SeriesID">@item.SeriesTitle</a></h3>
								<span class="card__category">
									<a href="/Series/SeriesDetail/@item.SeriesID">TV Series</a>
									<span style="color: #b9b9c0; font-size: 11px; margin-left: auto;">@item.SeriesCreatedYear</span>
								</span>
							</div>
						</div>
					</div>
				}
			}
			else
			{
				<div class="col-12" style="padding: 40px 0; text-align: center;">
					<h3 style="color: #fff;">Henüz yayınlanmış bir dizi bulunmamaktadır.</h3>
				</div>
			}

			@if (Model.TotalPages > 1)
			{
				<!-- paginator -->
				<div class="col-12">
					<ul class="paginator">
						@if (Model.HasPreviousPage)
						{
							<li class="paginator__item paginator__item--prev">
								<a href="?page=@(Model.CurrentPage - 1)">&laquo;</a>
							</li>
						}
						@for (int i = 1; i <= Model.TotalPages; i++)
						{
							<li class="paginator__item @(Model.CurrentPage == i ? "paginator__item--active" : "")">
								<a href="?page=@i">@i</a>
							</li>
						}
						@if (Model.HasNextPage)
						{
							<li class="paginator__item paginator__item--next">
								<a href="?page=@(Model.CurrentPage + 1)">&raquo;</a>
							</li>
						}
					</ul>
				</div>
				<!-- end paginator -->
			}
		</div>
	</div>
</div>
<!-- end catalog -->
