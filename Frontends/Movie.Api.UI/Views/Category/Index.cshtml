@model Movie.Api.UI.Models.CategoryDetailViewModel

@{
    ViewData["Title"] = $"Kategori: {Model.CategoryName}";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<!-- head -->
<section class="section section--head section--head-fixed">
	<div class="container">
		<div class="row">
			<div class="col-12 col-xl-6">
				<h1 class="section__title section__title--head">Kategori: @Model.CategoryName</h1>
			</div>

			<div class="col-12 col-xl-6">
				<ul class="breadcrumb">
					<li class="breadcrumb__item"><a href="/">Ana Sayfa</a></li>
					<li class="breadcrumb__item"><a href="/Movie/MovieList">Kategoriler</a></li>
					<li class="breadcrumb__item breadcrumb__item--active">@Model.CategoryName</li>
				</ul>
			</div>
		</div>
	</div>
</section>
<!-- end head -->

<!-- catalog -->
<div class="catalog catalog--page">
	<div class="container">
		<div class="row">
			<div class="col-12">
				<div class="catalog__nav">
					<div class="catalog__select-wrap">
						<span class="catalog__select-title">Kategori İçeriği:</span>
					</div>
					<span class="catalog__pages">@(Model.Movies.Count + Model.Series.Count) İçerik Bulundu</span>
				</div>
			</div>
		</div>

		<div class="row row--grid">
			@if (Model.Movies.Any())
			{
				foreach (var movie in Model.Movies)
				{
					<div class="col-12 col-sm-6 col-lg-4 col-xl-3">
						<div class="card">
							<a href="/Movie/MovieDetail/@movie.MovieID" class="card__cover">
								<img src="@(string.IsNullOrEmpty(movie.MovieCoverImageURL) ? "/FlixTheme/images/1.jpg" : movie.MovieCoverImageURL)" alt="@movie.MovieTitle" style="object-fit: cover; height: 360px; width: 100%;">
								<span class="card__play">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18.54,9,5,1.15A2.51,2.51,0,0,0,1.15,3.37V18.63A2.51,2.51,0,0,0,5,20.85L18.54,13A2.51,2.51,0,0,0,18.54,9Z"></path></svg>
								</span>
							</a>
							<div class="card__content">
								<h3 class="card__title"><a href="/Movie/MovieDetail/@movie.MovieID">@movie.MovieTitle</a></h3>
								<span class="card__category">
									<a href="#">Film</a>
								</span>
								<div class="card__wrap">
									<span class="card__rate">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22,9.67A1,1,0,0,0,21.14,9l-5.69-.83L12.9,3a1,1,0,0,0-1.8,0L8.55,8.16,2.86,9a1,1,0,0,0-.55,1.7l4.11,4L5.45,20.4a1,1,0,0,0,1.45,1.05L12,18.68l5.1,2.77a1,1,0,0,0,1.45-1.05l-.97-5.7,4.11-4A1,1,0,0,0,22,9.67Z"></path></svg>
										@movie.MovieRating
									</span>
									<ul class="card__list">
										<li>@movie.MovileCreatedYear</li>
										<li>@(movie.MovieDuration) dk</li>
									</ul>
								</div>
							</div>
						</div>
					</div>
				}
			}

			@if (Model.Series.Any())
			{
				foreach (var series in Model.Series)
				{
					<div class="col-12 col-sm-6 col-lg-4 col-xl-3">
						<div class="card">
							<a href="/Series/SeriesDetail/@series.SeriesID" class="card__cover">
								<img src="@(string.IsNullOrEmpty(series.SeriesCoverImageURL) ? "/FlixTheme/images/1.jpg" : series.SeriesCoverImageURL)" alt="@series.SeriesTitle" style="object-fit: cover; height: 360px; width: 100%;">
								<span class="card__play">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18.54,9,5,1.15A2.51,2.51,0,0,0,1.15,3.37V18.63A2.51,2.51,0,0,0,5,20.85L18.54,13A2.51,2.51,0,0,0,18.54,9Z"></path></svg>
								</span>
							</a>
							<div class="card__content">
								<h3 class="card__title"><a href="/Series/SeriesDetail/@series.SeriesID">@series.SeriesTitle</a></h3>
								<span class="card__category">
									<a href="#">TV Dizisi</a>
								</span>
								<div class="card__wrap">
									<span class="card__rate">
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22,9.67A1,1,0,0,0,21.14,9l-5.69-.83L12.9,3a1,1,0,0,0-1.8,0L8.55,8.16,2.86,9a1,1,0,0,0-.55,1.7l4.11,4L5.45,20.4a1,1,0,0,0,1.45,1.05L12,18.68l5.1,2.77a1,1,0,0,0,1.45-1.05l-.97-5.7,4.11-4A1,1,0,0,0,22,9.67Z"></path></svg>
										@series.SeriesRating
									</span>
									<ul class="card__list">
										<li>@series.SeriesCreatedYear</li>
										<li>@(series.SeriesSeasonCount) Sezon</li>
									</ul>
								</div>
							</div>
						</div>
					</div>
				}
			}

			@if (!Model.Movies.Any() && !Model.Series.Any())
			{
				<div class="col-12" style="padding: 50px 0; text-align: center;">
					<h3 style="color: #fff;">Bu kategoride henüz film veya dizi bulunmamaktadır.</h3>
				</div>
			}
		</div>
	</div>
</div>
<!-- end catalog -->
