@{
    ViewData["Title"] = "404 - Sayfa Bulunamadı";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<!-- page 404 -->
<div class="page-404 section--bg" data-bg="/FlixTheme/images/bg.jpg" style="padding: 100px 0; min-height: calc(100vh - 200px); display: flex; align-items: center; justify-content: center;">
	<div class="container">
		<div class="row">
			<div class="col-12">
				<div class="page-404__wrap" style="text-align: center;">
					<div class="page-404__content">
						<h1 class="page-404__title" style="font-size: 120px; color: #ff55a5; font-weight: 700; margin: 0; line-height: 1;">404</h1>
						<p class="page-404__text" style="color: #fff; font-size: 22px; margin: 20px 0 30px 0;">Aradığınız sayfa bulunamadı veya taşınmış olabilir!</p>
						<a href="/" class="page-404__btn" style="background: linear-gradient(90deg, #ff55a5 0%, #ff5860 100%); color: #fff; padding: 12px 35px; border-radius: 6px; text-transform: uppercase; font-weight: 600; text-decoration: none; display: inline-block;">
							Ana Sayfaya Dön
						</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
<!-- end page 404 -->
