@model CreateSeasonDto
@{
    ViewData["Title"] = "CreateSeason";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int seriesId = Model?.SeriesID ?? (ViewBag.SeriesID != null ? (int)ViewBag.SeriesID : 0);
    string seriesTitle = ViewBag.SeriesTitle != null ? ViewBag.SeriesTitle.ToString() : $"Dizi #{seriesId}";
}

<div class="cinema-shell">
    <div class="cinema-topbar">
        <div class="d-flex align-items-start align-items-md-center justify-content-between gap-3 flex-column flex-md-row">
            <div>
                <h5 class="cinema-title">
                    <span class="badge-dot"></span>
                    Yeni Sezon Ekle (@seriesTitle)
                </h5>
                <div class="cinema-sub">Sezon bilgilerini girin ve kaydet butonuna basın • FlixTheme</div>
            </div>

            <div class="cinema-actions">
                <a href="/Admin/AdminSeason/SeasonList?seriesId=@seriesId" class="btn-cinema btn-cinema-ghost">
                    <ion-icon name="arrow-back-outline"></ion-icon>
                    Sezonlara Dön
                </a>
            </div>
        </div>
    </div>

    <div class="cinema-body">
        <div class="cinema-card">
            <div class="cinema-card-head">
                <div class="d-flex align-items-center gap-3 cinema-card-head-row">
                    <span class="tag tag-lg">
                        <ion-icon name="albums-outline"></ion-icon>
                    </span>

                    <div>
                        <div class="cinema-card-title">Sezon Formu</div>
                        <div class="muted">Diziye yeni bir sezon ekleyin</div>
                    </div>
                </div>
            </div>

            <div class="cinema-card-body">
                <form method="post" asp-area="Admin" asp-action="CreateSeason" asp-controller="AdminSeason">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="SeriesID" />

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-4" role="alert">
                            @Html.ValidationSummary(false, "", new { @class = "text-danger m-0" })
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="cinema-label">Sezon Numarası</label>
                            <div class="cinema-input">
                                <span class="cinema-input-icon">
                                    <ion-icon name="list-number-outline"></ion-icon>
                                </span>
                                <input asp-for="SeasonNumber"
                                       class="form-control cinema-control"
                                       type="number"
                                       min="1"
                                       placeholder="Örn: 1"
                                       required />
                            </div>
                            <span asp-validation-for="SeasonNumber" class="cinema-val"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="cinema-label">Yayın Tarihi</label>
                            <div class="cinema-input">
                                <span class="cinema-input-icon">
                                    <ion-icon name="calendar-outline"></ion-icon>
                                </span>
                                <input asp-for="AirDate"
                                       class="form-control cinema-control"
                                       type="date" />
                            </div>
                            <span asp-validation-for="AirDate" class="cinema-val"></span>
                        </div>

                        <div class="col-12">
                            <label class="cinema-label">Poster Görsel URL</label>
                            <div class="cinema-input">
                                <span class="cinema-input-icon">
                                    <ion-icon name="image-outline"></ion-icon>
                                </span>
                                <input asp-for="PosterImageUrl"
                                       class="form-control cinema-control"
                                       placeholder="https://.../poster.jpg"
                                       autocomplete="off" />
                            </div>
                            <span asp-validation-for="PosterImageUrl" class="cinema-val"></span>
                        </div>

                        <div class="col-12">
                            <label class="cinema-label">Sezon Açıklaması / Genel Bakış</label>
                            <div class="cinema-input">
                                <span class="cinema-input-icon" style="align-self:flex-start; margin-top:10px;">
                                    <ion-icon name="document-text-outline"></ion-icon>
                                </span>
                                <textarea asp-for="Overview"
                                          class="form-control cinema-control"
                                          rows="5"
                                          placeholder="Sezonun konusu veya özet bilgisi..."
                                          style="resize:none;"></textarea>
                            </div>
                            <span asp-validation-for="Overview" class="cinema-val"></span>
                        </div>
                    </div>

                    <div class="mt-4 cinema-divider"></div>

                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <button type="submit" class="btn-cinema btn-cinema-primary">
                            <ion-icon name="save-outline"></ion-icon>
                            Kaydet
                        </button>

                        <a href="/Admin/AdminSeason/SeasonList?seriesId=@seriesId" class="btn-cinema btn-cinema-ghost">
                            <ion-icon name="close-circle-outline"></ion-icon>
                            Vazgeç
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
