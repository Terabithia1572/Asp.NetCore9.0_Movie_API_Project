@model List<ResultSeasonDto>
@{
    ViewData["Title"] = "SeasonList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
    int seriesId = ViewBag.SeriesID != null ? (int)ViewBag.SeriesID : 0;
    string seriesTitle = ViewBag.SeriesTitle != null ? ViewBag.SeriesTitle.ToString() : $"Dizi #{seriesId}";
}

<div class="cinema-shell">
    <div class="cinema-topbar">
        <div class="d-flex align-items-start align-items-md-center justify-content-between gap-3 flex-column flex-md-row">
            <div>
                <h5 class="cinema-title">
                    <span class="badge-dot"></span>
                    @seriesTitle - Sezon Yönetimi
                </h5>
                <div class="cinema-sub">Diziye ait sezonları görüntüleyin, ekleyin ve düzenleyin • FlixTheme</div>
            </div>

            <div class="cinema-actions">
                <a href="/Admin/AdminSeries/SeriesList" class="btn-cinema btn-cinema-ghost">
                    <ion-icon name="arrow-back-outline"></ion-icon>
                    Dizilere Dön
                </a>

                <a href="/Admin/AdminSeason/CreateSeason?seriesId=@seriesId" class="btn-cinema btn-cinema-primary">
                    <ion-icon name="add-circle-outline"></ion-icon>
                    Yeni Sezon Ekle
                </a>
            </div>
        </div>
    </div>

    <div class="cinema-body">
        <div class="table-responsive">
            <table class="cinema-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Poster</th>
                        <th>Sezon Numarası</th>
                        <th>Yayın Tarihi</th>
                        <th>Açıklama</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr class="cinema-row">
                                <td>@count</td>

                                <td>
                                    @if (!string.IsNullOrEmpty(item.PosterImageUrl))
                                    {
                                        <img src="@item.PosterImageUrl" alt="Poster" style="width:45px; height:60px; object-fit:cover; border-radius:6px;" />
                                    }
                                    else
                                    {
                                        <div class="tag tag-lg">
                                            <ion-icon name="albums-outline"></ion-icon>
                                        </div>
                                    }
                                </td>

                                <td>
                                    <div class="movie-title">
                                        <span class="clap">
                                            <ion-icon name="albums-outline"></ion-icon>
                                        </span>
                                        <div>
                                            <div>Sezon @item.SeasonNumber</div>
                                            <div class="muted">ID: @item.SeasonID</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="muted">
                                    @(item.AirDate.HasValue ? item.AirDate.Value.ToString("dd.MM.yyyy") : "-")
                                </td>

                                <td class="muted" style="max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                                    @(string.IsNullOrEmpty(item.Overview) ? "-" : item.Overview)
                                </td>

                                <td>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <a href="/Admin/AdminEpisode/EpisodeList?seasonId=@item.SeasonID" class="btn-mini btn-mini-info">
                                            <ion-icon name="list-outline"></ion-icon>
                                            Bölümler
                                        </a>
                                        <a href="/Admin/AdminSeason/UpdateSeason/@item.SeasonID" class="btn-mini btn-mini-warning">
                                            <ion-icon name="create-outline"></ion-icon>
                                            Güncelle
                                        </a>
                                        <a href="/Admin/AdminSeason/DeleteSeason?id=@item.SeasonID&seriesId=@seriesId" class="btn-mini btn-mini-danger" onclick="return confirm('Bu sezonu silmek istediğinize emin misiniz?');">
                                            <ion-icon name="trash-outline"></ion-icon>
                                            Sil
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 muted">
                                Bu diziye ait henüz bir sezon bulunmamaktadır.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
