@model Movie.Api.UI.Areas.Admin.Controllers.PlatformSettingsModel

@{
    ViewData["Title"] = "Platform Ayarları";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid" style="padding: 24px; max-width: 900px; margin: 0 auto;">
    <div style="margin-bottom: 32px;">
        <h2 style="font-family: 'Bebas Neue', sans-serif; font-size: 42px; letter-spacing: 2px; color: #fff; margin: 0;">
            PLATFORM <em style="color: #e50914; font-style: normal;">AYARLARI</em>
        </h2>
        <p style="color: #777; font-size: 13px; margin-top: 4px;">Genel site bilgileri, iletişim detayları ve bakım modu konfigürasyonu</p>
    </div>

    @if (ViewBag.SuccessMessage != null)
    {
        <div style="background: rgba(0,184,148,0.15); color: #00b894; border: 1px solid #00b894; padding: 16px; border-radius: 8px; margin-bottom: 24px; font-weight: 600;">
            ✔ @ViewBag.SuccessMessage
        </div>
    }

    <div style="background: #111111; border: 1px solid #222222; border-radius: 12px; padding: 32px;">
        <form asp-action="Index" method="post">
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 11px; text-transform: uppercase; color: #888; margin-bottom: 8px;">Platform Başlığı</label>
                <input asp-for="PlatformTitle" type="text" style="width: 100%; background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 12px 16px; color: #fff; font-size: 14px; outline: none;" />
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 11px; text-transform: uppercase; color: #888; margin-bottom: 8px;">Platform Alt Başlığı / Slogan</label>
                <input asp-for="PlatformSubtitle" type="text" style="width: 100%; background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 12px 16px; color: #fff; font-size: 14px; outline: none;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                <div>
                    <label style="display: block; font-size: 11px; text-transform: uppercase; color: #888; margin-bottom: 8px;">İletişim E-Postası</label>
                    <input asp-for="ContactEmail" type="email" style="width: 100%; background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 12px 16px; color: #fff; font-size: 14px; outline: none;" />
                </div>
                <div>
                    <label style="display: block; font-size: 11px; text-transform: uppercase; color: #888; margin-bottom: 8px;">İletişim Telefonu</label>
                    <input asp-for="ContactPhone" type="text" style="width: 100%; background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 12px 16px; color: #fff; font-size: 14px; outline: none;" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 24px;">
                <div>
                    <label style="display: block; font-size: 11px; text-transform: uppercase; color: #888; margin-bottom: 8px;">Logo URL</label>
                    <input asp-for="LogoUrl" type="text" style="width: 100%; background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 12px 16px; color: #fff; font-size: 14px; outline: none;" />
                </div>
                <div>
                    <label style="display: block; font-size: 11px; text-transform: uppercase; color: #888; margin-bottom: 8px;">Varsayılan Dil</label>
                    <select asp-for="DefaultLanguage" style="width: 100%; background: #1a1a1a; border: 1px solid #333; border-radius: 8px; padding: 12px 16px; color: #fff; font-size: 14px; outline: none;">
                        <option value="tr-TR">Türkçe (tr-TR)</option>
                        <option value="en-US">English (en-US)</option>
                    </select>
                </div>
            </div>

            <div style="background: #181818; padding: 20px; border-radius: 8px; border: 1px solid #282828; margin-bottom: 32px; display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <div style="font-weight: 600; color: #fff; font-size: 14px;">Bakım Modu (Maintenance Mode)</div>
                    <div style="color: #777; font-size: 12px; margin-top: 2px;">Aktif edildiğinde sadece yöneticiler siteye erişebilir.</div>
                </div>
                <div>
                    <input type="checkbox" asp-for="MaintenanceMode" style="width: 20px; height: 20px; accent-color: #e50914; cursor: pointer;" />
                </div>
            </div>

            <div style="display: flex; justify-content: flex-end;">
                <button type="submit" style="background: #e50914; color: #fff; padding: 12px 28px; border-radius: 8px; border: none; font-size: 13px; font-weight: 600; cursor: pointer;">
                    ✦ Ayarları Kaydet
                </button>
            </div>
        </form>
    </div>
</div>
